
pipeline {
    agent any

    environment {
        VENV = "${WORKSPACE}/.jenkins-venv"
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                dir('python-flask-app') {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                        python3 -m venv "$VENV"
                        "$VENV/bin/python" -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('python-flask-app') {
                    echo 'Running unit tests...'
                    sh '''
                        "$VENV/bin/python" -m unittest discover -s . -p "test_*.py"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('python-flask-app') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p "$DEPLOY_DIR"
                        cp app.py "$DEPLOY_DIR/"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('python-flask-app') {
                    echo 'Checking deployed Flask application...'
                    sh '''
                        cd "$DEPLOY_DIR"
                        "$VENV/bin/python" -c "from app import app; print(app.url_map)"
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                dir('python-flask-app') {
                    echo 'Verifying deployed Flask application...'
                    sh '''
                        cd "$DEPLOY_DIR"
                        "$VENV/bin/python" -c "from app import app; r = app.test_client().get('/'); assert r.status_code == 200; assert r.get_data(as_text=True) == 'Hello, Jenkins Multi-Stage Pipeline!'; print(r.get_data(as_text=True))"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output for details.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
